{
  "name": "jds-batch8-assessment",
  "private": true,
  "version": "2.0.0",
  "description": "JDS Batch 8 recruitment committee assessment: encrypted, client-only questionnaire plus a private local reviewer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:build": "node scripts/check-public-build.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:build",
    "keys:generate": "node scripts/generate-keys.ts",
    "decrypt": "node scripts/decrypt.ts",
    "reviewer:build": "vite build --config vite.reviewer.config.ts",
    "reviewer": "npm run reviewer:build && node reviewer/server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
