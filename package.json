{
  "name": "fakhri-master-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Master portfolio of Muhammad Fakhri Helmi: an introduction that links to his separate public case-study websites.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check": "node scripts/check.mjs",
    "check:dist": "node scripts/check.mjs --dist",
    "verify": "npm run typecheck && npm run check && npm run build && npm run check:dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/sofia-sans-extra-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
